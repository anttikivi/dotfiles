#!/usr/bin/env -S uv run --script

import json
import os
import select
import subprocess
import sys
import time
from pathlib import Path


TIMEOUT = 3


class LspClient:
    def __init__(self, command, cwd):
        self.process = subprocess.Popen(
            command,
            cwd=cwd,
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
        )
        self.buffer = b""
        self.next_id = 1

    def send(self, message):
        body = json.dumps(message, separators=(",", ":")).encode()
        header = f"Content-Length: {len(body)}\r\n\r\n".encode()
        self.process.stdin.write(header + body)
        self.process.stdin.flush()

    def notify(self, method, params=None):
        message = {"jsonrpc": "2.0", "method": method}
        if params is not None:
            message["params"] = params
        self.send(message)

    def request(self, method, params):
        request_id = self.next_id
        self.next_id += 1
        self.send(
            {
                "jsonrpc": "2.0",
                "id": request_id,
                "method": method,
                "params": params,
            }
        )

        deadline = time.monotonic() + TIMEOUT
        while True:
            message = self.read_message(deadline)
            if message.get("id") == request_id and "method" not in message:
                if "error" in message:
                    raise RuntimeError(message["error"].get("message", "LSP request failed"))
                return message.get("result")
            if "id" in message and "method" in message:
                self.respond_to_server(message)

    def read_message(self, deadline):
        while True:
            header_end = self.buffer.find(b"\r\n\r\n")
            if header_end >= 0:
                headers = self.buffer[:header_end].decode("ascii")
                lengths = [
                    line.split(":", 1)[1].strip()
                    for line in headers.split("\r\n")
                    if line.lower().startswith("content-length:")
                ]
                if not lengths:
                    raise RuntimeError("ZLS sent a response without Content-Length")
                length = int(lengths[0])
                body_start = header_end + 4
                if len(self.buffer) >= body_start + length:
                    body = self.buffer[body_start : body_start + length]
                    self.buffer = self.buffer[body_start + length :]
                    return json.loads(body)

            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise TimeoutError("timed out waiting for ZLS")
            readable, _, _ = select.select([self.process.stdout], [], [], remaining)
            if not readable:
                raise TimeoutError("timed out waiting for ZLS")
            chunk = os.read(self.process.stdout.fileno(), 65536)
            if not chunk:
                raise RuntimeError("ZLS exited before responding")
            self.buffer += chunk

    def respond_to_server(self, message):
        method = message["method"]
        if method == "workspace/configuration":
            result = [{} for _ in message.get("params", {}).get("items", [])]
        elif method == "workspace/workspaceFolders":
            result = None
        else:
            result = None
        self.send({"jsonrpc": "2.0", "id": message["id"], "result": result})

    def close(self):
        try:
            self.request("shutdown", None)
            self.notify("exit")
            self.process.wait(timeout=TIMEOUT)
        except (BrokenPipeError, RuntimeError, TimeoutError, subprocess.TimeoutExpired):
            self.process.kill()
            self.process.wait()


def workspace_root(path):
    for directory in (path.parent, *path.parents):
        if (directory / "build.zig").is_file() or (directory / ".git").exists():
            return directory
    return path.parent


def position_offset(text, position, encoding):
    lines = text.splitlines(keepends=True)
    line_number = position["line"]
    if line_number >= len(lines):
        return len(text)

    line = lines[line_number]
    units = position["character"]
    offset = 0
    for character in line:
        if encoding == "utf-8":
            width = len(character.encode("utf-8"))
        elif encoding == "utf-32":
            width = 1
        else:
            width = len(character.encode("utf-16-le")) // 2
        if units < width:
            break
        units -= width
        offset += 1
        if units == 0:
            break

    return sum(len(previous) for previous in lines[:line_number]) + offset


def apply_edits(text, edits, encoding):
    replacements = []
    for edit in edits:
        start = position_offset(text, edit["range"]["start"], encoding)
        end = position_offset(text, edit["range"]["end"], encoding)
        replacements.append((start, end, edit["newText"]))

    for start, end, replacement in sorted(replacements, reverse=True):
        text = text[:start] + replacement + text[end:]
    return text


def action_edits(action, uri):
    edit = action.get("edit", {})
    if "changes" in edit:
        return edit["changes"].get(uri, [])

    edits = []
    for change in edit.get("documentChanges", []):
        if change.get("textDocument", {}).get("uri") == uri:
            edits.extend(change.get("edits", []))
    return edits


def organize(path, source, zls):
    root = workspace_root(path)
    uri = path.as_uri()
    root_uri = root.as_uri()
    client = LspClient([zls], root)
    try:
        initialization = client.request(
            "initialize",
            {
                "processId": os.getpid(),
                "clientInfo": {"name": "zls-organize-imports"},
                "rootUri": root_uri,
                "workspaceFolders": [{"uri": root_uri, "name": root.name}],
                "capabilities": {
                    "general": {"positionEncodings": ["utf-8", "utf-16"]},
                    "textDocument": {
                        "codeAction": {
                            "codeActionLiteralSupport": {
                                "codeActionKind": {
                                    "valueSet": ["source.organizeImports"]
                                }
                            }
                        }
                    },
                },
            },
        )
        encoding = initialization.get("capabilities", {}).get(
            "positionEncoding", "utf-16"
        )
        client.notify("initialized", {})
        client.notify(
            "textDocument/didOpen",
            {
                "textDocument": {
                    "uri": uri,
                    "languageId": "zig",
                    "version": 1,
                    "text": source,
                }
            },
        )
        actions = client.request(
            "textDocument/codeAction",
            {
                "textDocument": {"uri": uri},
                "range": {
                    "start": {"line": 0, "character": 0},
                    "end": {"line": len(source.splitlines()), "character": 0},
                },
                "context": {
                    "diagnostics": [],
                    "only": ["source.organizeImports"],
                    "triggerKind": 1,
                },
            },
        )
        for action in actions or []:
            if action.get("kind") == "source.organizeImports":
                return apply_edits(source, action_edits(action, uri), encoding)
        return source
    finally:
        client.notify("textDocument/didClose", {"textDocument": {"uri": uri}})
        client.close()


def main():
    if len(sys.argv) != 2:
        raise RuntimeError("usage: zls-organize-imports FILE")

    path = Path(sys.argv[1]).expanduser().resolve()
    zls = os.environ.get("ZLS", str(Path.home() / ".local/opt/zls/bin/zls"))
    if not os.access(zls, os.X_OK):
        raise RuntimeError(f"ZLS is not executable: {zls}")

    sys.stdout.write(organize(path, sys.stdin.read(), zls))


if __name__ == "__main__":
    try:
        main()
    except Exception as error:
        print(f"zls-organize-imports: {error}", file=sys.stderr)
        sys.exit(1)
