+" ---------------------------------------------------------------------
+" s:NetrwRestoreRegisters: restores registers saved by NetrwWideListing {{{2
+fun! s:NetrwRestoreRegisters(registers)
+  for i in range(0, 9)
+   call setreg(i, a:registers[i])
+  endfor
+  call setreg('a', a:registers.a)
+  " Restore the unnamed register last so that it points to the original register.
+  call setreg('', a:registers.unnamed)
+endfun
+
